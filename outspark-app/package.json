{
  "name": "outspark-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sh ./start.sh",
    "build": "python3 scripts/flutter_project.py build",
    "preview": "python3 scripts/serve_flutter.py",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test": "python3 scripts/flutter_project.py check",
    "dev:prototype": "vite --port 5190",
    "build:demo": "python3 scripts/flutter_project.py build --demo --api http://127.0.0.1:18080/api --landing http://127.0.0.1:5177/",
    "build:prototype": "vite build --outDir .local/react-prototype"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  }
}
